APP_NAME="Πληροφοριακό Σύστημα για καταγραφή και ανάλυση ατυχημάτων"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/ptixiaki/public
APP_TIMEZONE=Europe/Athens

SESSION_NAME=ptixiaki_session
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=traffic_accidents
DB_USER=postgres
DB_PASS=postgres
DB_SCHEMA=public

UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_BASE_DIR=storage/uploads

RATE_LIMIT_LOGIN_MAX_ATTEMPTS=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_INVITATION_MAX_ATTEMPTS=10
RATE_LIMIT_INVITATION_WINDOW_SECONDS=900
RATE_LIMIT_INVITATION_LOCKOUT_SECONDS=900

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NAME="Διαχειριστής Συστήματος"

MAIL_ENABLED=true
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@traffic-accidents.local
MAIL_FROM_NAME="Σύστημα Τροχαίων Ατυχημάτων"
MAIL_HELO=localhost
MAIL_TIMEOUT=10
